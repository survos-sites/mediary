{
	servers {
		# Dokku's nginx terminates TLS before forwarding over the Docker bridge.
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	root * /app/public

	# No `encode` directive: mediary.survos.com is Cloudflare-proxied, and Cloudflare
	# compresses on the way to the browser regardless of what the origin sends.
	# Setting Content-Encoding here adds a layer that can go wrong in transit --
	# confirmed live on packages with zstd (valid at the origin, broke every asset in
	# the browser with net::ERR_CONTENT_DECODING_FAILED once it hit Cloudflare's
	# edge). Let Cloudflare own it end to end.

	# mediary receives image uploads and multi-page PDFs. php.ini raises
	# upload_max_filesize/post_max_size to 512M; Caddy has to allow the body through
	# first or PHP never sees the request.
	# Request size is capped in THREE places; the smallest wins:
	#   1. dokku's host nginx in front of this container. Not in this repo: dokku generates
	#      /home/dokku/mediary/nginx.conf (hand edits are overwritten). Set it with
	#        dokku nginx:set mediary client-max-body-size 32m && dokku proxy:build-config mediary
	#      The dokku default is 1m, which rejected harvest's 500-row /batch (~1 MB) with 413.
	#   2. here (Caddy request_body)
	#   3. docker/php.ini post_max_size / upload_max_filesize
	request_body {
		max_size 512MB
	}

	# Browsers ask for /favicon.ico unprompted on the first page view of every
	# session. Without a terminating route the request falls through to PHP
	# and Symfony answers it with a NotFoundHttpException -- the single noisiest
	# line in the production log, and never a real error. `handle` blocks are
	# mutually exclusive and evaluated in the order written, so this one ends the
	# request here: public/favicon.ico is served if it exists, otherwise 204, and
	# PHP is never booted either way.
	handle /favicon.ico {
		@missing not file
		respond @missing 204
		file_server
	}

	handle {
		php_fastcgi 127.0.0.1:9000 {
			capture_stderr
		}
		file_server
	}
}
