###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> survos/imgproxy-bundle ###
IMGPROXY_HOST=https://imgproxy.survos.com
IMGPROXY_KEY=
IMGPROXY_SALT=
###< survos/imgproxy-bundle ###

# most of the time we use flysystem, but sometimes we need direct access
APP_DATA_DIR=/platform

# Tesseract OCR microservice endpoint. Leave empty to disable OCR.
OCR_HOST=https://tesseract.survos.com/tesseract
EDGE_ANALYSIS_URL=http://127.0.0.1:8000
AI_TOOLS_BASE_URI=https://ai-tools.survos.com
# Optional local file path remapping when ai-tools runs in Docker.
# Example:
# AI_TOOLS_LOCAL_PATH_HOST_PREFIX=/mnt/volume-1/platform-data
# AI_TOOLS_LOCAL_PATH_CONTAINER_PREFIX=/platform
AI_TOOLS_LOCAL_PATH_HOST_PREFIX=
AI_TOOLS_LOCAL_PATH_CONTAINER_PREFIX=
# Local canonical persistence root (override in .env.local as needed).
MEDIA_CANONICAL_DIR=
AI_PAID_TOOLS_ENABLED=0
SERVICE_MIN_INTERVAL_MS=1000
SERVICE_HTTP_TIMEOUT_SECONDS=120
SERVICE_529_COOLDOWN_MS=1000

###> symfony/ai-open-ai-platform ###
OPENAI_API_KEY=
###< symfony/ai-open-ai-platform ###

###> symfony/ai-anthropic-platform ###
ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###

###> symfony/ai-mistral-platform ###
MISTRAL_API_KEY=
###< symfony/ai-mistral-platform ###

###> survos/ai-workflow-bundle (AssemblyAiTranscribeTask) ###
# survos-sites/musdig#24 / survos-sites/ai-tools#1 — speech-to-text + speaker
# diarization for YouTube/interview audio. Get a key at https://www.assemblyai.com/ .
ASSEMBLYAI_API_KEY=
###< survos/ai-workflow-bundle (AssemblyAiTranscribeTask) ###

ZIPS_DIR=

AI_TOOLS_HOST=https://ai-tools.survos.com
AI_TOOLS_SHARED_DIR=false # really should fail if not set!


###> symfony/ai-generic-platform ###
# GENERIC_BASE_URL=https://api.example.com/v1
###< symfony/ai-generic-platform ###
MEDIARY_ENDPOINT=https://mediary.survos.com

###> survos/search-bundle ###
# SEARCH_DEFAULT_DSN="meilisearch://key@localhost:7700"
SEARCH_DEFAULT_DSN=doctrine://default
# Full-text adapter for AssetSearch. Must match the DATABASE_URL backend:
# postgres-bm25://default on PostgreSQL, sqlite-fts5://default on SQLite
# (override in .env.local). The factory throws on a backend mismatch.
SEARCH_BM25_DSN=postgres-bm25://default
###< survos/search-bundle ###
###> survos/ai-workflow-bundle ###
AI_TOOLS_URL=https://ai-tools.survos.com
###< survos/ai-workflow-bundle ###

# Shared claims DB. Set in .env.local for dev and in production environment config.
CLAIMS_DATABASE_URL=
