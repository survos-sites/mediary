{% extends 'base.html.twig' %}
{% block title %}Image search{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/image-search.css') }}">{% endblock %}
{% block body %}
{% set sc = survos_stimulus('search-bundle', 'instantsearch') %}
<div class="im-shell" {{ stimulus_controller(sc, {endpoint: path('survos_search_instant'), name: name, template: path('app_image_search_template'), sorts: sorts}) }}>
    <header class="im-heading">
        <div>
            <h1>Images</h1>
            <p>Every asset mediary has processed, searchable by its AI description, detected objects, OCR text and source metadata.</p>
        </div>
    </header>
    <div class="im-searchbox" {{ stimulus_target(sc, 'query') }}></div>
    <div class="im-error" hidden role="alert" {{ stimulus_target(sc, 'error') }}></div>
    <div class="im-workspace">
        <aside class="im-sidebar" aria-label="Search filters">
            <div class="im-filter-heading"><h2>Refine results</h2><div {{ stimulus_target(sc, 'clear') }}></div></div>
            {% for field, label in facets %}<section class="im-facet"><h3>{{ label }}</h3><div data-field="{{ field }}" data-label="{{ label }}" {{ stimulus_target(sc, 'facet') }}></div></section>{% endfor %}
            {% for field, label in ranges %}<section class="im-facet"><h3>{{ label }}</h3><div data-field="{{ field }}" data-label="{{ label }}" {{ stimulus_target(sc, 'range') }}></div></section>{% endfor %}
        </aside>
        <main class="im-results">
            <div class="im-toolbar"><div aria-live="polite" {{ stimulus_target(sc, 'stats') }}></div><div aria-label="Sort results" {{ stimulus_target(sc, 'sort') }}></div></div>
            <div class="im-current" {{ stimulus_target(sc, 'current') }}></div>
            <div {{ stimulus_target(sc, 'hits') }}></div>
            <div class="im-pagination" {{ stimulus_target(sc, 'pagination') }}></div>
        </main>
    </div>
</div>
{% endblock %}
